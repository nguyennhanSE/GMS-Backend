# Copy this file to .env.dev for local development.
#
# Non-production environments load .env.dev.
# Production loads .env.prod.
#
# Notes:
# - APP_RUNTIME_ROLE defaults to `all` outside production.
# - APP_RUNTIME_ROLE=all is valid for local development only.
# - EMAIL_FROM must be a Resend-verified sender when email delivery is enabled.
# - SUPPORT_EMAIL_TO is optional locally; support emails are skipped when blank.
# - COHERE_API_KEY is only needed when CHATBOT_COHERE_ENABLED=true.
# - Redis settings are only used when REDIS_ENABLED=true.

# Application
APP_PORT=3001
APP_RUNTIME_ROLE=all
APP_HOST=http://localhost:3001

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres
DATABASE_SCHEMA=public
DATABASE_URL=postgresql://postgres:123456@localhost:5540/postgres

# JWT
JWT_SECRET_ACCESS_TOKEN=GMSAccessTokenSecret
JWT_SECRET_REFRESH_TOKEN=GMSRefreshTokenSecret
JWT_TOKEN_EXPIRATION_TIME=1d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=24h
REFRESH_TOKEN_REMEMBER_EXPIRES_IN=30d

# Email
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_EMAIL_TIMEOUT_MS=10000
EMAIL_FROM=GMS <notifications@example.com>
SUPPORT_EMAIL_TO=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cohere / Chatbot
COHERE_API_URL=https://api.cohere.com/v2/chat
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024
CHATBOT_COHERE_ENABLED=false
CHATBOT_SESSION_TTL_HOURS=24
CHATBOT_CONTEXT_PAIRS=5

# Redis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=300
