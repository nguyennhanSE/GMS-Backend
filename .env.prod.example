# Copy this file to .env.prod before running the production server.
#
# Production rules from src/libs/config/index.ts:
# - .env.prod is loaded only when NODE_ENV=production.
# - APP_HOST, FRONTEND_URL, DATABASE_URL, Resend email settings, Stripe settings,
#   and RABBITMQ_URL are required in production.
# - COHERE_API_KEY is required only when CHATBOT_COHERE_ENABLED=true.
# - REDIS_HOST and REDIS_PORT are required only when REDIS_ENABLED=true.
# - APP_RUNTIME_ROLE must be `web` or `worker` in production. `all` is invalid.
# - EMAIL_FROM must be a Resend-verified sender and does not fall back automatically.

# Application
APP_PORT=3500
# Use `web` for the HTTP app and `worker` for background consumers/cron jobs.
APP_RUNTIME_ROLE=web
APP_HOST=https://api.example.com

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=https://app.example.com

# Database
DATABASE_HOST=postgres.internal
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-production-password
DATABASE_NAME=gms
DATABASE_SCHEMA=public
DATABASE_URL=postgresql://postgres:replace-with-production-password@postgres.internal:5432/gms?schema=public

# JWT
JWT_SECRET_ACCESS_TOKEN=replace-with-production-access-secret
JWT_SECRET_REFRESH_TOKEN=replace-with-production-refresh-secret
JWT_TOKEN_EXPIRATION_TIME=1d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_REMEMBER_EXPIRES_IN=30d

# Email
RESEND_API_KEY=re_live_replace_me
RESEND_API_URL=https://api.resend.com/emails
RESEND_EMAIL_TIMEOUT_MS=10000
EMAIL_FROM=GMS <notifications@example.com>
SUPPORT_EMAIL_TO=support@example.com

# Stripe
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=https://app.example.com/payment/success
STRIPE_CANCEL_URL=https://app.example.com/payment/cancel

# RabbitMQ
RABBITMQ_URL=amqp://user:password@rabbitmq.internal:5672

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Cohere / Chatbot
COHERE_API_URL=https://api.cohere.com/v2/chat
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024
CHATBOT_COHERE_ENABLED=true
CHATBOT_SESSION_TTL_HOURS=24
CHATBOT_CONTEXT_PAIRS=5

# Redis
REDIS_ENABLED=false
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=300
