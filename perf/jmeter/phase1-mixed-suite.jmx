        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Lookup Provider Session Id" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.sql.DriverManager

Class.forName(vars.get('jdbcDriver'))
def conn = DriverManager.getConnection(vars.get('jdbcUrl'), vars.get('jdbcUsername'), vars.get('jdbcPassword'))
try {
  def sql = 'select provider_session_id from payments where target_type::text = ? and target_id = ?::uuid order by created_at desc limit 1'
  def stmt = conn.prepareStatement(sql)
  stmt.setString(1, 'CLASS_BOOKING')
  stmt.setString(2, vars.get('bookingId'))
  def rs = stmt.executeQuery()
  if (!rs.next()) {
    throw new IllegalStateException('No provider_session_id found for booking ' + vars.get('bookingId'))
  }
  vars.put('providerSessionId', rs.getString(1))
  rs.close()
  stmt.close()
} finally {
  conn.close()
}</stringProp>
        </JSR223Sampler>
        <hashTree />
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Build Stripe Webhook Event" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonOutput
import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec

def payload = JsonOutput.toJson([
  id: 'evt_smoke_' + System.currentTimeMillis(),
  object: 'event',
  type: 'checkout.session.completed',
  data: [
    object: [
      id: vars.get('providerSessionId'),
      payment_intent: 'pi_smoke_' + System.currentTimeMillis(),
    ],
  ],
])

def timestamp = (System.currentTimeMillis() / 1000L) as long
def signedPayload = timestamp + '.' + payload
def mac = Mac.getInstance('HmacSHA256')
mac.init(new SecretKeySpec(vars.get('stripeWebhookSecret').getBytes('UTF-8'), 'HmacSHA256'))
def digest = mac.doFinal(signedPayload.getBytes('UTF-8')).encodeHex().toString()

vars.put('stripePayload', payload)
vars.put('stripeSignature', 't=' + timestamp + ',v1=' + digest)</stringProp>
        </JSR223Sampler>
