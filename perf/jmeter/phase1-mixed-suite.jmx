        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Build Booking Payload" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonOutput
import java.time.LocalDate

def dayMap = [SUN:0, MON:1, TUE:2, WED:3, THU:4, FRI:5, SAT:6]
def scheduleDay = vars.get('classScheduleDay')
if (!scheduleDay || !dayMap.containsKey(scheduleDay)) {
  throw new IllegalStateException('Missing classScheduleDay for transaction booking payload: ' + scheduleDay)
}

def sequence = (vars.get('bookingSequence') ?: '0') as int
sequence++
vars.put('bookingSequence', String.valueOf(sequence))
vars.remove('bookingId')
vars.remove('checkoutUrl')
vars.remove('providerSessionId')

def baseDate = LocalDate.parse(vars.get('targetDate'))
def baseDay = baseDate.getDayOfWeek().getValue() % 7
def dayDelta = (dayMap[scheduleDay] - baseDay + 7) % 7
def weekOffset = 5000 + (sequence - 1) + (ctx.getThreadNum() * 1000)
def startDate = baseDate.plusDays(dayDelta + (weekOffset * 7L))
def endDate = startDate.plusDays(1)
vars.put('bookingPayload', JsonOutput.toJson([
  userId: vars.get('memberUserId'),
  classScheduleId: [vars.get('classScheduleId')],
  bookingStartDate: startDate.toString(),
  bookingEndDate: endDate.toString(),
]))</stringProp>
        </JSR223Sampler>
