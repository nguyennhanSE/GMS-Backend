          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Member Auth Header" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Accept</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Authorization</stringProp>
                  <stringProp name="Header.value">Bearer ${memberAccessToken}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree />
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Class Schedule" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
def responseBody = prev.getResponseDataAsString()
if (!(prev.getResponseCode()?.startsWith('2'))) {
  throw new IllegalStateException('Class schedule discovery failed. HTTP ' + prev.getResponseCode() + ' body=' + responseBody)
}
def body = new JsonSlurper().parseText(responseBody)
def docs = body.data?.docs ?: []
if (docs.isEmpty()) {
  throw new IllegalStateException('No schedules returned for ' + vars.get('targetDate') + '. body=' + responseBody)
}
def schedule = docs.size() > 1 ? docs[1] : docs[0]
def scheduleDay = (schedule.daysOfWeek ?: [schedule.dayOfWeek]).find { it }
if (!scheduleDay) {
  throw new IllegalStateException('Selected schedule did not expose dayOfWeek or daysOfWeek. body=' + responseBody)
}
vars.put('classScheduleId', schedule.id as String)
vars.put('classScheduleDay', scheduleDay as String)</stringProp>
