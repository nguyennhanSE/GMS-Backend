              <stringProp name="script">import groovy.json.JsonSlurper
def responseBody = prev.getResponseDataAsString()
def body = new JsonSlurper().parseText(responseBody)
def accessToken = body.data?.accessToken
if (!accessToken) {
  throw new IllegalStateException('Admin login did not return access token. HTTP ' + prev.getResponseCode() + ' body=' + responseBody)
}
vars.put('adminAccessToken', accessToken as String)</stringProp>
