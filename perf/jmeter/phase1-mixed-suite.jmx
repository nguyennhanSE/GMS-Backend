          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.net.URI
import java.net.InetSocketAddress
import java.net.Socket

def uri = new URI(vars.get('baseUrl'))
def scheme = uri.getScheme() ?: 'http'
def host = uri.getHost() ?: 'localhost'
def port = uri.getPort() &gt; 0 ? uri.getPort() : (scheme == 'https' ? 443 : 80)
def path = uri.getPath() ?: ''
if (path.endsWith('/')) {
  path = path.substring(0, path.length() - 1)
}

props.put('perf.apiScheme', scheme)
props.put('perf.apiHost', host)
props.put('perf.apiPort', String.valueOf(port))
props.put('perf.apiBasePath', path)

def requireJdbc = 'true'.equalsIgnoreCase(vars.get('requireJdbc'))
def requireStripe = 'true'.equalsIgnoreCase(vars.get('requireStripe'))

def stripeSecret = vars.get('stripeWebhookSecret')
if (requireStripe &amp;&amp; (!stripeSecret || stripeSecret == 'CHANGE_ME')) {
  throw new IllegalStateException('stripeWebhookSecret must be set for webhook scenarios')
}

if (requireJdbc) {
  try {
    Class.forName(vars.get('jdbcDriver'))
  } catch (ClassNotFoundException ex) {
    throw new IllegalStateException('PostgreSQL JDBC driver not found in JMeter lib: ' + vars.get('jdbcDriver'))
  }

  if (!vars.get('jdbcPassword') || vars.get('jdbcPassword') == 'CHANGE_ME') {
    throw new IllegalStateException('jdbcPassword must be set for DB lookup scenarios')
  }
}

[
  [name: 'redis', host: vars.get('redisHost'), port: vars.get('redisPort') as int],
  [name: 'rabbitmq', host: vars.get('rabbitmqHost'), port: vars.get('rabbitmqPort') as int],
].each { target -&gt;
  Socket socket = new Socket()
  try {
    socket.connect(new InetSocketAddress(target.host as String, target.port as int), 3000)
  } finally {
    try {
      socket.close()
    } catch (ignored) {
    }
  }
}

log.info('Preflight completed for ' + vars.get('baseUrl'))</stringProp>
        </JSR223Sampler>
