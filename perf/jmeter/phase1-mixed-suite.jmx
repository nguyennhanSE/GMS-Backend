              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
def responseBody = prev.getResponseDataAsString()
def body = new JsonSlurper().parseText(responseBody)
def accessToken = body.data?.accessToken
def userId = body.data?.user?.id
if (!accessToken || !userId) {
  throw new IllegalStateException('Admin login did not return access token and user id. HTTP ' + prev.getResponseCode() + ' body=' + responseBody)
}
vars.put('adminAccessToken', accessToken as String)
vars.put('adminUserId', userId as String)</stringProp>
            </JSR223PostProcessor>
