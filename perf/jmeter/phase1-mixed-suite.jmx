            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.net.URI
import java.time.DayOfWeek
import java.time.LocalDate
import java.time.ZoneOffset

def uri = new URI(vars.get('baseUrl'))
def path = uri.getPath() ?: ''
if (path.endsWith('/')) {
  path = path.substring(0, path.length() - 1)
}
vars.put('apiBasePath', path)

def today = LocalDate.now(ZoneOffset.UTC)
int delta = (DayOfWeek.MONDAY.getValue() - today.getDayOfWeek().getValue() + 7) % 7
if (delta == 0) {
  delta = 7
}
vars.put('targetDate', today.plusDays(delta).toString())</stringProp>
