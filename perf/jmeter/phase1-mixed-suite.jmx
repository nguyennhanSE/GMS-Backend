          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Booking Id" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def responseBody = prev.getResponseDataAsString()
def body = new JsonSlurper().parseText(responseBody)
def items = body.data ?: []
if (items.isEmpty() || !items[0]?.id) {
  throw new IllegalStateException('Booking create returned no items. HTTP ' + prev.getResponseCode() + ' body=' + responseBody)
}
vars.put('bookingId', items[0].id as String)</stringProp>
          </JSR223PostProcessor>
