          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Checkout Url" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def responseBody = prev.getResponseDataAsString()
if (!(prev.getResponseCode()?.startsWith('2'))) {
  throw new IllegalStateException('Checkout request failed. HTTP ' + prev.getResponseCode() + ' body=' + responseBody)
}
def body = new JsonSlurper().parseText(responseBody)
def checkoutUrl = body.data?.checkoutUrl
if (!checkoutUrl) {
  throw new IllegalStateException('Checkout response did not contain data.checkoutUrl. HTTP ' + prev.getResponseCode() + ' body=' + responseBody)
}
vars.put('checkoutUrl', checkoutUrl as String)</stringProp>
          </JSR223PostProcessor>
