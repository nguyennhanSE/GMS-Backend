          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Member Login" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
def responseBody = prev.getResponseDataAsString()
def body = new JsonSlurper().parseText(responseBody)
def accessToken = body.data?.accessToken
def userId = body.data?.user?.id
if (!accessToken || !userId) {
  throw new IllegalStateException('Member login did not return access token and user id. HTTP ' + prev.getResponseCode() + ' body=' + responseBody)
}
vars.put('memberAccessToken', accessToken as String)
vars.put('memberUserId', userId as String)</stringProp>
            </JSR223PostProcessor>
